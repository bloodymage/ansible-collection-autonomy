# {{ ansible_managed }}

{% if autonomy_common_dns_rpz_enabled and autonomy_common_dns_rpz_zones is truthy %}
{% for rpz in autonomy_common_dns_rpz_zones -%}
{% if rpz["type"] == "primary" -%}
  zone {{ rpz["name"] }} {
  type primary;
  notify no;
  allow-query { {{ rpz['allow_query'] }}; };
{% if rpz['definition'] == 'dynamic' %}
  allow-transfer { any; };
  allow-update { key {{ autonomy_common_zone_name }};  };
{% if rpz['also_notify'] is defined and rpz['also_notify'] is truthy %}
  also-notify {
  {% for host in rpz['also_notify'] %}
    {{ host }};
  {% endfor %}
  };
{% endif %}
{% endif %}
{% if rpz['path'] is defined %}
  file "{{ rpz['path'] }}";
{% else %}
  file "{{ autonomy_common_bind_zone_dir }}/db.{{ rpz['name'] }}.rpz";
{% endif %}
};

{% endif %}
{% endfor %}
{% for rpz in autonomy_common_dns_rpz_zones -%}
{% if rpz["type"] == "secondary" -%}
  zone {{ rpz["name"] }} {
  type secondary;
  notify no;
  allow-query { {{ rpz['allow_query'] }}; };
  primaries {
  {% for ns in rpz['nameservers'] %}
    {{ ns }};
  {% endfor %}
};
{% if rpz['path'] is defined %}
  file "{{ rpz['path'] }}";
{% else %}
  file "{{ autonomy_common_bind_zone_dir }}/db.{{ rpz['name'] }}.rpz";
{% endif %}
};

{% endif %}
{% endfor %}
{% endif %}
