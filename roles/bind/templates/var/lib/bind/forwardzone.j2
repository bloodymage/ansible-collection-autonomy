; ==================================================================================================
;
; BIND data file for {{ autonomy_common_zone_domain }}
;
; {{ ansible_managed }}
;
; ==================================================================================================
$TTL	{{ autonomy_bind_zone_ttl }}
@	IN	SOA	{{ autonomy_bind_zone_soa }}. {{ autonomy_bind_zone_admin }}. (
{{ autonomy_bind_zone_serial_number.ljust(20) }}  ; Serial
{{ autonomy_bind_zone_refresh.ljust(20) }}  ; Refresh
{{ autonomy_bind_zone_retry.ljust(20) }}  ; Retry
{{ autonomy_bind_zone_expire.ljust(20) }}  ; Expire
{{ autonomy_bind_zone_negative_cache_ttl.ljust(20) }}  ; Negative Cache TTL
)
;
{% for ns in groups[autonomy_common_zone_name + '_dns_servers'] -%}
  {{ '@'.ljust(10) }}{{ 'IN'.ljust(4) }}{{ 'NS'.ljust(6) }}{{ hostvars[ns]['inventory_hostname_short'] }}.{{ autonomy_common_zone_domain }}.
{% endfor %}


{% for ns in groups[autonomy_common_zone_name + '_dns_servers'] -%}
  {{ hostvars[ns]['inventory_hostname_short'] }}.{{ autonomy_common_zone_domain }}.      IN A      {{ hostvars[ns]['ansible_host'] }}
{% endfor %}
{% if zone_address_ipv4 is defined -%}
  {{ '@'.ljust(10) }}{{ 'IN'.ljust(4) }}{{ 'A'.ljust(6) }}{{ zone_address_ipv4 }}
{% endif %}
