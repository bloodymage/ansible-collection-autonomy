{% endif %}
{% if autonomy_openssh_sshd_conf_x11_use_localhost != __autonomy_openssh_sshd_conf_x11_use_localhost -%}
  X11UseLocalhost {{ autonomy_openssh_sshd_conf_x11_use_localhost }}
{% endif %}
{% if autonomy_openssh_sshd_conf_permit_tty != __autonomy_openssh_sshd_conf_permit_tty -%}
  PermitTTY {{ autonomy_openssh_sshd_conf_permit_tty }}
{% endif %}
{% if autonomy_openssh_sshd_conf_print_motd != __autonomy_openssh_sshd_conf_print_motd -%}
  PrintMotd {{ autonomy_openssh_sshd_conf_print_motd }}
{% endif %}
{% if autonomy_openssh_sshd_conf_print_last_log != __autonomy_openssh_sshd_conf_print_last_log -%}
  PrintLastLog {{ autonomy_openssh_sshd_conf_print_last_log }}
{% endif %}
{% if autonomy_openssh_sshd_conf_tcp_keep_alive != __autonomy_openssh_sshd_conf_tcp_keep_alive -%}
  TCPKeepAlive {{ autonomy_openssh_sshd_conf_tcp_keep_alive }}
{% endif %}
{% if autonomy_openssh_sshd_conf_permit_user_environment != __autonomy_openssh_sshd_conf_permit_user_environment -%}
  PermitUserEnvironment {{ autonomy_openssh_sshd_conf_permit_user_environment }}
{% endif %}
{% if autonomy_openssh_sshd_conf_client_compression != __autonomy_openssh_sshd_conf_client_compression -%}
  Compression {{ autonomy_openssh_sshd_conf_client_compression }}
{% endif %}
{% if autonomy_openssh_sshd_conf_client_alive_interval != __autonomy_openssh_sshd_conf_client_alive_interval -%}
  ClientAliveInterval {{ autonomy_openssh_sshd_conf_client_alive_interval }}
{% endif %}
{% if autonomy_openssh_sshd_conf_client_alive_count_max != __autonomy_openssh_sshd_conf_client_alive_count_max -%}
  ClientAliveCountMax {{ autonomy_openssh_sshd_conf_client_alive_count_max }}
{% endif %}
{% if autonomy_openssh_sshd_conf_use_dns != __autonomy_openssh_sshd_conf_use_dns -%}
  UseDNS {{ autonomy_openssh_sshd_conf_use_dns }}
{% endif %}
{% if autonomy_openssh_sshd_pid_path != __autonomy_openssh_sshd_pid_path -%}
  PidFile {{ autonomy_openssh_sshd_pid_path }}
{% endif %}
{% if autonomy_openssh_sshd_conf_max_startups != __autonomy_openssh_sshd_conf_max_startups -%}
  MaxStartups {{ autonomy_openssh_sshd_conf_max_startups }}
{% endif %}
{% if autonomy_openssh_sshd_conf_permit_tunnel != __autonomy_openssh_sshd_conf_permit_tunnel -%}
  PermitTunnel {{ autonomy_openssh_sshd_conf_permit_tunnel }}
{% endif %}
{% if autonomy_openssh_sshd_conf_chroot_dir != __autonomy_openssh_sshd_conf_chroot_dir -%}
  ChrootDirectory {{ autonomy_openssh_sshd_conf_chroot_dir }}
{% endif %}
{% if autonomy_openssh_sshd_conf_version_addendum is truthy -%}
  VersionAddendum {{ autonomy_openssh_sshd_conf_version_addendum }}
{% endif %}

{% if autonomy_openssh_sshd_conf_banner != __autonomy_openssh_sshd_conf_banner -%}
  Banner {{ autonomy_openssh_sshd_conf_banner }}
{% endif %}
{% if autonomy_openssh_sshd_conf_accept_env is truthy -%}
  AcceptEnv
  {%- for item in autonomy_openssh_sshd_conf_accept_env -%}
    {{ " " }}{{ item }}
  {%- endfor %}
{% endif %}

{# override default of no subsystems #}
{% if autonomy_openssh_sshd_conf_subsystems is truthy -%}
  {%- for item in autonomy_openssh_sshd_conf_subsystems -%}
    Subsystem {{ item }}
  {% endfor %}
{% endif %}

