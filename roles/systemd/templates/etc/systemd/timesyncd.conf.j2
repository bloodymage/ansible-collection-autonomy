[Time]
{% if autonomy_systemd_timesyncd_server_addresses is truthy -%}
  NTP=
{%- for server in autonomy_systemd_timesyncd_server_addresses -%}
  {{ server }}{{ " " if not loop.last else "" }}
{%- endfor %}
{% endif %}
{% if autonomy_systemd_timesyncd_fallback_server_addresses is truthy -%}
  FallbackNTP=
{%- for server in autonomy_systemd_timesyncd_fallback_server_addresses -%}
  {{ server }}{{ " " if not loop.last else "" }}
{%- endfor %}
{% endif %}
{% if autonomy_systemd_timesyncd_root_distance_max_sec != __autonomy_systemd_timesyncd_root_distance_max_sec -%}
  RootDistanceMaxSec={{ autonomy_systemd_timesyncd_root_distance_max_sec }}
{% endif %}
{% if autonomy_systemd_timesyncd_poll_interval_min_sec != __autonomy_systemd_timesyncd_poll_interval_min_sec -%}
  PollIntervalMinSec={{ autonomy_systemd_timesyncd_poll_interval_min_sec }}
{% endif %}
{% if autonomy_systemd_timesyncd_poll_interval_max_sec != __autonomy_systemd_timesyncd_poll_interval_max_sec -%}
  PollIntervalMaxSec={{ autonomy_systemd_timesyncd_poll_interval_max_sec }}
{% endif %}
{% if autonomy_systemd_timesyncd_connection_retry_sec != __autonomy_systemd_timesyncd_connection_retry_sec -%}
  ConnectionRetrySec={{ autonomy_systemd_timesyncd_connection_retry_sec }}
{% endif %}
{% if autonomy_systemd_timesyncd_save_interval_sec != __autonomy_systemd_timesyncd_save_interval_sec -%}
  SaveIntervalSec={{ autonomy_systemd_timesyncd_save_interval_sec }}
{% endif %}
