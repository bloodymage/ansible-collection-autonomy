# {{ ansible_managed }}

[Match]
Name={{ item['name'] }}
{% if item['ssid'] is defined %}
SSID={{ item['ssid'] }}
{% endif %}
{% if item['permanent_mac_address'] is defined %}
PermanentMACAddress={{ item['permanent_mac_address'] }}
{% endif %}
{% if item['path'] is defined %}
Path={{ item['path'] }}
{% endif %}
{% if item['driver'] is defined %}
Driver={{ item['driver'] }}
{% endif %}

{% if item['link'] is defined and item['link'] is truthy %}
[Link]
{% if item['link']['mac_address'] is defined %}
MACAddress={{ item['link']['mac_address'] }}
{% endif %}
{% if item['link']['required_for_online'] is defined %}
RequiredForOnline={{ item['link']['required_for_online'] }}
{% endif %}
{% endif %}

[Network]
{% if item['description'] is defined %}
Description={{ item['description'] }}
{% endif %}
{% if item['bond'] is defined %}
Bond={{ item['bond'] }}
{% if item['primary_slave'] is defined %}
PrimarySlave={{ item['primary_slave'] }}
{% endif %}
{% endif %}
{% if item['dhcp'] is defined %}
DHCP={{ item['dhcp'] }}
{% else %}
{% if item['address'] is defined and item['gateway'] is defined %}
Address={{ item['address'] }}
Gateway={{ item['gateway'] }}
{% endif %}
{% endif %}
{% if item['dns'] is defined %}
DNS=
{%- for ip in item['dns'] -%}
{{ ip }}{{ " " if not loop['last'] else "" }}
{%- endfor %}
{% endif %}
{% if item['domains'] is defined +%}
Domains=
{%- for domain in item['domains'] -%}
{{ domain }}{{ " " if not loop['last'] else "" }}
{% endfor %}
{% endif %}
{% if item['llmnr'] is defined %}
LLMNR={{ item['llmnr'] }}
{% endif %}
{% if item['multicast_dns'] is defined +%}
MulticastDNS={{ item['multicast_dns'] }}
{% endif %}
{% if item['dns_over_tls'] is defined %}
DNSOverTLS={{ item['dns_over_tls'] }}
{% endif %}
{% if item['dnssec'] is defined %}
DNSSEC={{ item['dnssec'] }}
{% endif %}
{% if item['dnssec_negative_trust_anchors'] is defined %}
DNSSECNegativeTrustAnchors={{ item['dns_negative_trust_anchors'] }}
{% endif %}
{% if item['lldp'] is defined %}
LLDP={{ item['lldp'] }}
{% endif %}
{% if item['emit_lldp'] is defined %}
EmitLLDP={{ item['emit_lldp'] }}
{% endif %}
{% if item['bind_carrier'] is defined %}
BindCarrier={{ item['bind_carrier'] }}
{% endif %}
{% if item['dns_default_route'] is defined %}
DNSDefaultRoute={{ item['dns_default_route'] }}
{% endif %}
{% if item['ntp'] is defined %}
{% for ntp_server in item['ntp'] %}
NTP={{ ntp_server }}
{% endfor %}
{% endif %}
{% if item['vlans'] is defined %}

# VLANs
{% for vlan in item['vlans'] %}
VLAN={{ vlan }}
{% endfor %}
{% endif %}
{% if item['macvlans'] is defined %}

# MACVLANs
{% for vlan in item['macvlans'] %}
MACVLAN={{ vlan }}
{% endfor %}
{% endif %}
{% if item['route'] is defined and item['route'] is truthy %}

{% for route in item['route'] %}
[ROUTE]
{% if route['gateway'] is defined and route['gateway'] is truthy %}
Gateway={{ route['gateway'] }}
{% endif %}
{% if route['destination'] is defined and route['destination'] is truthy %}
Destination={{ route['destination'] }}
{% endif %}
{% if route['metric'] is defined and route['metric'] is truthy %}
Metric={{ route['metric'] }}
{% endif %}

{% endfor %}
{% endif %}
{% if item['dhcpv4'] is defined and item['dhcpv4'] is truthy %}

[DHCPv4]
{% if item['dhcpv4']['hostname'] is defined %}
Hostname={{ item['dhcpv4']['hostname'] }}
{% endif %}
{% endif %}
{% if item['dhcpv6'] is defined and item['dhcpv6'] is truthy %}

[DHCPv6]
{% if item['dhcpv6']['hostname'] is defined %}
Hostname={{ item['dhcpv6']['hostname'] }}
{% endif %}
{% endif %}
